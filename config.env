#!/usr/bin/env bash
# Voice Pipeline Configuration

AUDIO_DEVICE=":1"                          # Sennheiser Profile (AVFoundation index)
WHISPER_BIN="$HOME/.voice-pipeline/venv/bin/whisper"
CLAUDE_BIN="$HOME/.local/bin/claude"
HA_ENTITY="media_player.office_speaker"    # Google Cast entity
HA_URL="http://192.168.1.208:8123"
HA_TTS_ENTITY="tts.elevenlabs_text_to_speech"
RECORD_DURATION=5                          # Max seconds per recording chunk
SILENCE_THRESHOLD="-30dB"                  # Silence detection threshold
SILENCE_DURATION="1.5"                     # Seconds of silence to stop recording
WHISPER_MODEL="base"                       # whisper model (tiny/base/small/medium/large)
WHISPER_LANGUAGE="en"
TMP_DIR="/tmp/voice-pipeline"
CONTROL_FIFO="/tmp/voice-pipeline/control.fifo"
