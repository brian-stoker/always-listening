<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Microphone access for audio capture -->
    <key>com.apple.security.audio-input</key>
    <true/>

    <!-- Network client access for Home Assistant API calls -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Apple Events automation for dictation via osascript -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- Audio input device accessibility -->
    <key>com.apple.security.device.audio-input-access</key>
    <true/>
</dict>
</plist>
