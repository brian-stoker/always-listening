{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "features": ["custom-protocol"]
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "nsis"],
    "macOS": {
      "signing": {
        "identity": "$APPLE_SIGNING_IDENTITY"
      }
    }
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https:; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'"
    }
  }
}
